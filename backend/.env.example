MONGODB_URI=mongodb://localhost:27017/employee-feedback
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d
FRONTEND_URL=http://localhost:5173
PORT=5002
# These variables support the existing feedback/questionnaire and admin reply features.
# They are not used by employee HR chat.
AI_PROVIDER=gemini
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
RAG_AGENT_URL=http://127.0.0.1:5000/ask
RAG_AGENT_TIMEOUT_MS=185000
# The current RAG-Agent Flask route has no authentication; do not expose it publicly.
# Set these only after the agent validates the configured header.
RAG_AGENT_AUTH_HEADER=
RAG_AGENT_AUTH_VALUE=
RAG_AGENT_AUTH_VERIFIED=false